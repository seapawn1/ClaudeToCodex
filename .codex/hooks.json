{
  "description": "Cross-session messaging probes and the combined prototype bridge.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/ClaudeToCodex/IDEO/cross-session-agent-messaging/prototype/PostToolProbe.mjs\"",
            "timeout": 5,
            "async": false,
            "additionalContextLimit": 3000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/ClaudeToCodex/IDEO/cross-session-agent-messaging/prototype/Bridge.mjs\" hook",
            "timeout": 5,
            "async": false,
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/ClaudeToCodex/IDEO/cross-session-agent-messaging/prototype/Bridge.mjs\" hook",
            "timeout": 5,
            "async": false,
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/ClaudeToCodex/IDEO/cross-session-agent-messaging/prototype/Bridge.mjs\" hook",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ]
  }
}
