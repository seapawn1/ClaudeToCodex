{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/cli.mjs\" hook", "timeout": 5, "async": false, "additionalContextLimit": 20000 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/cli.mjs\" hook", "timeout": 5, "async": false, "additionalContextLimit": 20000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/cli.mjs\" hook", "timeout": 5, "async": false }
        ]
      }
    ]
  }
}
